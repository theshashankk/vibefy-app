<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Standard strict HTTPS enforce for all app API & CDN traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain config for music-wtf.vercel.app -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">music-wtf.vercel.app</domain>
        <domain includeSubdomains="true">vercel.app</domain>
    </domain-config>

    <!-- Opt-in domain config for creator vibe-sites that may still run legacy http assets -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">runable.site</domain>
    </domain-config>
</network-security-config>
